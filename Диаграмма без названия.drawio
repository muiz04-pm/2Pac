        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ЗАКАЗЧИКИ {\n        int id_заказчика PK\n        string наименование\n        string ИНН\n        string адрес\n        string телефон\n        boolean является_покупателем\n        boolean является_поставщиком\n    }\n\n    МАТЕРИАЛЫ {\n        int id_материала PK\n        string код\n        string наименование\n        string единица_измерения\n        decimal цена_за_единицу\n    }\n\n    ПРОДУКЦИЯ {\n        int id_продукции PK\n        string код\n        string наименование\n        string единица_измерения\n        decimal отпускная_цена\n    }\n\n    СОСТАВ_РЕЦЕПТА {\n        int id_строки_рецепта PK\n        string название_рецепта\n        int id_продукции FK\n        int id_материала FK\n        decimal количество_на_единицу\n    }\n\n    ВЫПУСК_ПАРТИИ {\n        int id_записи_выпуска PK\n        string номер_документа\n        date дата\n        string примечания\n        int id_продукции FK\n        decimal количество\n    }\n\n    ЗАКАЗЫ {\n        int id_заказа PK\n        string номер_документа\n        date дата\n        int id_заказчика FK\n        decimal сумма_итого\n    }\n\n    ПОЗИЦИЯ_ЗАКАЗА {\n        int id_позиции PK\n        int id_заказа FK\n        int id_продукции FK\n        decimal количество\n        decimal цена_на_момент_заказа\n        decimal сумма_строки\n    }\n\n    %% Связи\n    ЗАКАЗЧИКИ ||--o{ ЗАКАЗЫ : \&quot;размещает заказы\&quot;\n    ЗАКАЗЫ ||--o{ ПОЗИЦИЯ_ЗАКАЗА : \&quot;содержит позиции\&quot;\n    ПРОДУКЦИЯ ||--o{ СОСТАВ_РЕЦЕПТА : \&quot;имеет рецепты\&quot;\n    МАТЕРИАЛЫ ||--o{ СОСТАВ_РЕЦЕПТА : \&quot;используется в рецептах\&quot;\n    ПРОДУКЦИЯ ||--o{ ВЫПУСК_ПАРТИИ : \&quot;выпускается в партиях\&quot;\n\n    ЗАКАЗЫ }|--|| ЗАКАЗЧИКИ : \&quot;принадлежит покупателю\&quot;\n    ПОЗИЦИЯ_ЗАКАЗА }|--|| ЗАКАЗЫ : \&quot;часть заказа\&quot;\n    ПОЗИЦИЯ_ЗАКАЗА }|--|| ПРОДУКЦИЯ : \&quot;ссылается на продукцию\&quot;\n    ВЫПУСК_ПАРТИИ }|--|| ПРОДУКЦИЯ : \&quot;описывает выпуск\&quot;\n    СОСТАВ_РЕЦЕПТА }|--|| ПРОДУКЦИЯ : \&quot;относится к продукции\&quot;\n    СОСТАВ_РЕЦЕПТА }|--|| МАТЕРИАЛЫ : \&quot;ссылается на материал\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="f0rnNHUjNxa8J-8-yexa-1">
